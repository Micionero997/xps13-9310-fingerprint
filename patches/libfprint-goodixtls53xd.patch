+// Command sequence follows goodix-fp-dump's driver_53xd.py; DAC and
+// finger-lift values were measured on a Dell XPS 13 9310 2-in-1.
+
+#define FP_COMPONENT "goodixtls53xd"
+
+#include <glib.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "drivers_api.h"
+#include "fpi-byte-utils.h"
+#include "goodix.h"
+#include "goodix5xx.h"
+#include "goodix_proto.h"
+#include "goodix53xd.h"
+
+#define GOODIX53XD_WIDTH 64
+#define GOODIX53XD_HEIGHT 80
+#define GOODIX53XD_FRAME_SIZE (GOODIX53XD_WIDTH * GOODIX53XD_HEIGHT)
+// 4 pixels are packed in 6 bytes; the decrypted frame has a 4 byte trailer
+#define GOODIX53XD_RAW_FRAME_SIZE (GOODIX53XD_FRAME_SIZE / 4 * 6)
+// Upscale factor; with SIGFM 2x separated genuine and impostor scores best
+// (3x and 4x let some impostors score very high)
+#define GOODIX53XD_SCALE 2
+// Local contrast normalization window radius, see build_image()
+#define GOODIX53XD_NORM_RADIUS 3
+
+#define GOODIX53XD_CMD_MCU_SWITCH_TO_SLEEP_MODE (0x60)
+
+// One DAC step moves the readout by ~70 counts. At 0x10c an empty sensor
+// reads ~3640; a firmly pressed finger pulls the median down to 300-600.
+#define GOODIX53XD_DAC_BASE (0x10c)
+
+#define GOODIX53XD_REG_IMAGE (0x022c)
+#define GOODIX53XD_REG_IMAGE_ON (0x030a)
+#define GOODIX53XD_REG_IMAGE_OFF (0x020a)
+
+// A frame whose median is above this has no finger on it. Sessions often
+// start with the finger still on the sensor (e.g. between enroll stages), so
+// only such frames may become the background.
+#define GOODIX53XD_EMPTY_MEDIAN (3000)
+// Flat background used until an empty frame has been seen
+#define GOODIX53XD_EMPTY_LEVEL (3640)
+
+// A pixel is touched if the finger lowered it by this much from background
+#define GOODIX53XD_TOUCH_DELTA (600)
+#define GOODIX53XD_LIFT_POLL_MS (100)
+#define GOODIX53XD_TLS_SETTLE_MS (20)
+#define GOODIX53XD_FLUSH_MS (100)
+
+// FDT reports the very first contact, so keep sampling until the finger has
+// settled: coverage unchanged for GOODIX53XD_PRESS_STABLE_POLLS frames, or
+// give up after GOODIX53XD_PRESS_MAX_POLLS and use the best frame seen.
+#define GOODIX53XD_PRESS_MIN_COVERAGE (0.3)
+#define GOODIX53XD_PRESS_STABLE_DELTA (0.03)
+#define GOODIX53XD_PRESS_STABLE_POLLS (3)
+#define GOODIX53XD_PRESS_POLL_MS (50)
+#define GOODIX53XD_PRESS_MAX_POLLS (10)
+
+struct _FpiDeviceGoodixTls53xd
+{
+  FpiDeviceGoodixTls5xx parent;
+
+  FpiSsm               *scan_ssm;
+  gboolean              lifted;
+  gboolean              pressed;
+  gint                  press_polls;
+  gdouble               last_coverage;
+  gint                  stable_polls;
+  gboolean              scan_delayed; // a delayed transition is pending
+  gdouble               best_coverage;
+  // Kept across activations; only ever filled from finger-free frames
+  gboolean              background_valid;
+  GoodixTls5xxPix       background[GOODIX53XD_FRAME_SIZE];
+  GoodixTls5xxPix       frame[GOODIX53XD_FRAME_SIZE];
+  GoodixTls5xxPix       best_frame[GOODIX53XD_FRAME_SIZE];
+};
+
+G_DECLARE_FINAL_TYPE (FpiDeviceGoodixTls53xd, fpi_device_goodixtls53xd, FPI,
+                      DEVICE_GOODIXTLS53XD, FpiDeviceGoodixTls5xx);
+
+G_DEFINE_TYPE (FpiDeviceGoodixTls53xd, fpi_device_goodixtls53xd,
+               FPI_TYPE_DEVICE_GOODIXTLS5XX);
+
+// ---- HELPERS SECTION START ----
+
+static void
+send_fdt (FpDevice *dev, guint8 cmd, const guint8 *mode, gboolean reply,
+          guint timeout_ms, FpiSsm *ssm)
+{
+  guint8 payload[GOODIX_53XD_FDT_LEN + 1];
+
+  memcpy (payload, mode, GOODIX_53XD_FDT_LEN);
+  payload[GOODIX_53XD_FDT_LEN] = reply ? 0x01 : 0x00;
+
+  goodix_send_protocol (dev, cmd, payload, sizeof (payload), NULL, TRUE,
+                        timeout_ms, reply, goodixtls5xx_check_none_cmd, ssm);
+}
+
+static void
+request_image (FpDevice *dev, GoodixImageCallback callback, FpiSsm *ssm)
+{
+  const guint16 base = GOODIX53XD_DAC_BASE;
+  guint8 request[10];
+
+  request[0] = 0x01;
+  request[1] = 0x03;
+  // Per-quadrant DAC values, same offsets as driver_53xd.py
+  FP_WRITE_UINT16_LE (request + 2, base);
+  FP_WRITE_UINT16_LE (request + 4, base - 6);
+  FP_WRITE_UINT16_LE (request + 6, base);
+  FP_WRITE_UINT16_LE (request + 8, base - 4);
+
+  goodix_tls_read_image_request (dev, request, sizeof (request), callback, ssm);
+}
+
+static gboolean
+decode_frame (const guint8 *data, guint16 length, GoodixTls5xxPix *frame,
+              GError **error)
+{
+  if (!data || length < GOODIX53XD_RAW_FRAME_SIZE)
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                   "Invalid image frame (length: %d)", data ? length : 0);
+      return FALSE;
+    }
+
+  for (int i = 0; i != GOODIX53XD_RAW_FRAME_SIZE; i += 6)
+    {
+      const guint8 *chunk = data + i;
+      *frame++ = ((chunk[0] & 0xf) << 8) + chunk[1];
+      *frame++ = (chunk[3] << 4) + (chunk[0] >> 4);
+      *frame++ = ((chunk[5] & 0xf) << 8) + chunk[2];
+      *frame++ = (chunk[4] << 4) + (chunk[5] >> 4);
+    }
+  return TRUE;
+}
+
+static int
+touch_depth (const GoodixTls5xxPix *frame, const GoodixTls5xxPix *background,
+             int i)
+{
+  return MAX (0, (int) background[i] - (int) frame[i]);
+}
+
+static gdouble
+touched_share (const GoodixTls5xxPix *frame,
+               const GoodixTls5xxPix *background)
+{
+  int touched = 0;
+
+  for (int i = 0; i != GOODIX53XD_FRAME_SIZE; ++i)
+    if (touch_depth (frame, background, i) > GOODIX53XD_TOUCH_DELTA)
+      touched++;
+
+  return (gdouble) touched / GOODIX53XD_FRAME_SIZE;
+}
+
+// Debug aid: with FP_GOODIX53XD_DUMP=<dir>, save each raw frame followed by
+// the background (host-endian 16-bit pixels) for offline tuning
+static void
+dump_raw (const GoodixTls5xxPix *frame, const GoodixTls5xxPix *background,
+          const char *tag)
+{
+  static guint count = 0;
+  const gchar *dir = g_getenv ("FP_GOODIX53XD_DUMP");
+  g_autofree gchar *path = NULL;
+  FILE *file;
+
+  if (!dir)
+    return;
+
+  path = g_strdup_printf ("%s/raw-%04u-%s.bin", dir, count++, tag);
+  file = fopen (path, "wb");
+  if (!file)
+    return;
+  fwrite (frame, sizeof (GoodixTls5xxPix), GOODIX53XD_FRAME_SIZE, file);
+  fwrite (background, sizeof (GoodixTls5xxPix), GOODIX53XD_FRAME_SIZE, file);
+  fclose (file);
+}
+
+static int
+compare_int (const void *a, const void *b)
+{
+  return *(const int *) a - *(const int *) b;
+}
+
+// Background-subtract, normalize contrast locally (SIFT finds ~18 keypoints
+// per frame without it, below SIGFM's minimum of 25, and ~230 with it),
+// stretch the 1st-99th percentile to 8 bits with dark ridges, then upscale.
+// Must stay in sync with tools/sigfm-eval.cpp, which the threshold was
+// measured with.
+static FpImage *
+build_image (const GoodixTls5xxPix *frame, const GoodixTls5xxPix *background)
+{
+  const int r = GOODIX53XD_NORM_RADIUS;
+  int depth[GOODIX53XD_FRAME_SIZE];
+  int norm[GOODIX53XD_FRAME_SIZE];
+  int sorted[GOODIX53XD_FRAME_SIZE];
+  guint8 small[GOODIX53XD_FRAME_SIZE];
+  int lo, hi;
+  const int w = GOODIX53XD_WIDTH * GOODIX53XD_SCALE;
+  const int h = GOODIX53XD_HEIGHT * GOODIX53XD_SCALE;
+  FpImage *img;
+
+  for (int i = 0; i != GOODIX53XD_FRAME_SIZE; ++i)
+    depth[i] = touch_depth (frame, background, i);
+
+  for (int y = 0; y != GOODIX53XD_HEIGHT; ++y)
+    for (int x = 0; x != GOODIX53XD_WIDTH; ++x)
+      {
+        gdouble s = 0, s2 = 0, mean, sd;
+        int n = 0;
+
+        for (int yy = MAX (0, y - r); yy <= MIN (GOODIX53XD_HEIGHT - 1, y + r); ++yy)
+          for (int xx = MAX (0, x - r); xx <= MIN (GOODIX53XD_WIDTH - 1, x + r); ++xx)
+            {
+              gdouble v = depth[yy * GOODIX53XD_WIDTH + xx];
+              s += v;
+              s2 += v * v;
+              n++;
+            }
+        mean = s / n;
+        sd = sqrt (MAX (1.0, s2 / n - mean * mean));
+        norm[y * GOODIX53XD_WIDTH + x] =
+          (int) (1000 * (depth[y * GOODIX53XD_WIDTH + x] - mean) / sd);
+      }
+
+  memcpy (sorted, norm, sizeof (sorted));
+  qsort (sorted, GOODIX53XD_FRAME_SIZE, sizeof (int), compare_int);
+  lo = sorted[GOODIX53XD_FRAME_SIZE / 100];
+  hi = sorted[GOODIX53XD_FRAME_SIZE - 1 - GOODIX53XD_FRAME_SIZE / 100];
+  if (hi <= lo)
+    hi = lo + 1;
+
+  for (int i = 0; i != GOODIX53XD_FRAME_SIZE; ++i)
+    {
+      int d = CLAMP (norm[i], lo, hi);
+      small[i] = 255 - (d - lo) * 255 / (hi - lo);
+    }
+
+  img = fp_image_new (w, h);
+  img->flags |= FPI_IMAGE_PARTIAL;
+  for (int y = 0; y != h; ++y)
+    {
+      gdouble sy = CLAMP ((y + 0.5) / GOODIX53XD_SCALE - 0.5, 0,
+                          GOODIX53XD_HEIGHT - 1);
+      int y0 = (int) sy, y1 = MIN (y0 + 1, GOODIX53XD_HEIGHT - 1);
+      gdouble fy = sy - y0;
+
+      for (int x = 0; x != w; ++x)
+        {
+          gdouble sx = CLAMP ((x + 0.5) / GOODIX53XD_SCALE - 0.5, 0,
+                              GOODIX53XD_WIDTH - 1);
+          int x0 = (int) sx, x1 = MIN (x0 + 1, GOODIX53XD_WIDTH - 1);
+          gdouble fx = sx - x0;
+          gdouble top = small[y0 * GOODIX53XD_WIDTH + x0] * (1 - fx) +
+                        small[y0 * GOODIX53XD_WIDTH + x1] * fx;
+          gdouble bottom = small[y1 * GOODIX53XD_WIDTH + x0] * (1 - fx) +
+                           small[y1 * GOODIX53XD_WIDTH + x1] * fx;
+
+          img->data[y * w + x] = (guint8) (top * (1 - fy) + bottom * fy + 0.5);
+        }
+    }
+  return img;
+}
+
+// ---- HELPERS SECTION END ----
+
+// -----------------------------------------------------------------------------
+
+// ---- ACTIVE SECTION START ----
+
+enum activate_states {
+  ACTIVATE_READ_LOOP,
+  ACTIVATE_NOP,
+  ACTIVATE_CHECK_FW_VER,
+  ACTIVATE_CHECK_PSK,
+  ACTIVATE_RESET,
+  ACTIVATE_TLS,
+  ACTIVATE_UPLOAD_MCU_CONFIG,
+  ACTIVATE_FDT_MODE,
+  ACTIVATE_FDT_MODE_REPLY,
+  ACTIVATE_BACKGROUND_REG_ON,
+  ACTIVATE_BACKGROUND_IMAGE,
+  ACTIVATE_BACKGROUND_REG_OFF,
+  ACTIVATE_NUM_STATES,
+};
+
+static void
+check_psk (FpDevice *dev, guint8 *data, guint16 length, gpointer ssm,
+           GError *error)
+{
+  guint32 flags, psk_length;
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  if (length < 9 || data[0] != 0x00)
+    {
+      fpi_ssm_mark_failed (ssm, g_error_new (FP_DEVICE_ERROR,
+                                             FP_DEVICE_ERROR_PROTO,
+                                             "Failed to read PSK from device"));
+      return;
+    }
+
+  flags = FP_READ_UINT32_LE (data + 1);
+  psk_length = FP_READ_UINT32_LE (data + 5);
+  fp_dbg ("Device PSK flags: 0x%08x", flags);
+
+  if (flags != GOODIX_53XD_PSK_FLAGS ||
+      psk_length != sizeof (goodix_53xd_pmk_hash) ||
+      length < 9 + psk_length ||
+      memcmp (data + 9, goodix_53xd_pmk_hash, psk_length))
+    {
+      fpi_ssm_mark_failed (ssm, g_error_new (FP_DEVICE_ERROR,
+                                             FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                             "Sensor PSK is not the one flashed "
+                                             "by goodix-fp-dump"));
+      return;
+    }
+
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+check_reset (FpDevice *dev, guint8 *data, guint16 length, gpointer ssm,
+             GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  if (length < 3 || data[0] != 0x01)
+    {
+      fpi_ssm_mark_failed (ssm, g_error_new (FP_DEVICE_ERROR,
+                                             FP_DEVICE_ERROR_PROTO,
+                                             "Failed to reset device"));
+      return;
+    }
+
+  fp_dbg ("Device reset number: %d", FP_READ_UINT16_LE (data + 1));
+  if (FP_READ_UINT16_LE (data + 1) != GOODIX_53XD_RESET_NUMBER)
+    {
+      fpi_ssm_mark_failed (ssm, g_error_new (FP_DEVICE_ERROR,
+                                             FP_DEVICE_ERROR_PROTO,
+                                             "Invalid device reset number: %d",
+                                             FP_READ_UINT16_LE (data + 1)));
+      return;
+    }
+
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+on_tls_ready (FpDevice *dev, gpointer ssm, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  // goodix-fp-dump waits after the handshake, or the next command is lost
+  fpi_ssm_next_state_delayed (ssm, GOODIX53XD_TLS_SETTLE_MS);
+}
+
+static guint
+frame_median (const GoodixTls5xxPix *frame)
+{
+  guint hist[4096] = { 0 };
+  guint seen = 0;
+
+  for (int i = 0; i != GOODIX53XD_FRAME_SIZE; ++i)
+    hist[MIN (frame[i], 4095)]++;
+  for (guint v = 0; v != 4096; ++v)
+    {
+      seen += hist[v];
+      if (seen > GOODIX53XD_FRAME_SIZE / 2)
+        return v;
+    }
+  return 4095;
+}
+
+// If self->frame shows an empty sensor, make it the background. Returns
+// whether the sensor was empty.
+static gboolean
+update_background (FpiDeviceGoodixTls53xd *self)
+{
+  guint median = frame_median (self->frame);
+
+  if (median < GOODIX53XD_EMPTY_MEDIAN)
+    {
+      fp_dbg ("Finger on sensor (median %u), keeping %s background", median,
+              self->background_valid ? "previous" : "flat");
+      return FALSE;
+    }
+
+  memcpy (self->background, self->frame, sizeof (self->background));
+  self->background_valid = TRUE;
+  return TRUE;
+}
+
+static void
+on_background (FpDevice *dev, guint8 *data, guint16 length, gpointer ssm,
+               GError *error)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (dev);
+
+  if (!error)
+    decode_frame (data, length, self->frame, &error);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  update_background (self);
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+activate_run_state (FpiSsm *ssm, FpDevice *dev)
+{
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case ACTIVATE_READ_LOOP:
+      // Let replies left over from the previous session (the sensor keeps
+      // sending an image requested before deactivation) arrive, then drop
+      // them, like goodix-fp-dump's empty_buffer()
+      goodix_start_read_loop (dev);
+      fpi_ssm_next_state_delayed (ssm, GOODIX53XD_FLUSH_MS);
+      break;
+
+    case ACTIVATE_NOP:
+      goodix_flush_input (dev);
+      goodix_send_nop (dev, goodixtls5xx_check_none, ssm);
+      break;
+
+    case ACTIVATE_CHECK_FW_VER:
+      goodix_send_query_firmware_version (dev,
+                                          goodixtls5xx_check_firmware_version,
+                                          ssm);
+      break;
+
+    case ACTIVATE_CHECK_PSK:
+      {
+        guint8 payload[16];
+
+        // length, offset, flags, unused (53xd layout, not GoodixPresetPsk)
+        FP_WRITE_UINT32_LE (payload, sizeof (goodix_53xd_pmk_hash));
+        FP_WRITE_UINT32_LE (payload + 4, 0);
+        FP_WRITE_UINT32_LE (payload + 8, GOODIX_53XD_PSK_FLAGS);
+        FP_WRITE_UINT32_LE (payload + 12, 0);
+        goodix_send_protocol (dev, GOODIX_CMD_PRESET_PSK_READ, payload,
+                              sizeof (payload), NULL, TRUE, GOODIX_TIMEOUT,
+                              TRUE, check_psk, ssm);
+        break;
+      }
+
+    case ACTIVATE_RESET:
+      {
+        // Reset sensor (bits 0 and 2), no MCU soft reset, sleep 20 ms
+        const guint8 payload[] = { 0x05, 20 };
+
+        goodix_send_protocol (dev, GOODIX_CMD_RESET, payload, sizeof (payload),
+                              NULL, TRUE, GOODIX_TIMEOUT, TRUE, check_reset,
+                              ssm);
+        break;
+      }
+
+    case ACTIVATE_TLS:
+      goodix_tls_init (dev, on_tls_ready, ssm);
+      break;
+
+    case ACTIVATE_UPLOAD_MCU_CONFIG:
+      goodix_send_upload_config_mcu (dev, goodix_53xd_config,
+                                     sizeof (goodix_53xd_config), NULL,
+                                     goodixtls5xx_check_config_upload, ssm);
+      break;
+
+    case ACTIVATE_FDT_MODE:
+      send_fdt (dev, GOODIX_CMD_MCU_SWITCH_TO_FDT_MODE, goodix_53xd_fdt_mode,
+                FALSE, GOODIX_TIMEOUT, ssm);
+      break;
+
+    case ACTIVATE_FDT_MODE_REPLY:
+      send_fdt (dev, GOODIX_CMD_MCU_SWITCH_TO_FDT_MODE, goodix_53xd_fdt_mode,
+                TRUE, GOODIX_TIMEOUT, ssm);
+      break;
+
+    case ACTIVATE_BACKGROUND_REG_ON:
+      goodix_send_write_sensor_register (dev, GOODIX53XD_REG_IMAGE,
+                                         GOODIX53XD_REG_IMAGE_ON,
+                                         goodixtls5xx_check_none, ssm);
+      break;
+
+    case ACTIVATE_BACKGROUND_IMAGE:
+      request_image (dev, on_background, ssm);
+      break;
+
+    case ACTIVATE_BACKGROUND_REG_OFF:
+      goodix_send_write_sensor_register (dev, GOODIX53XD_REG_IMAGE,
+                                         GOODIX53XD_REG_IMAGE_OFF,
+                                         goodixtls5xx_check_none, ssm);
+      break;
+    }
+}
+
+static void
+activate_complete (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  if (error)
+    fp_err ("failed during activation: %s (code: %d)", error->message,
+            error->code);
+
+  fpi_image_device_activate_complete (FP_IMAGE_DEVICE (dev), error);
+}
+
+// ---- ACTIVE SECTION END ----
+
+// -----------------------------------------------------------------------------
+
+// ---- SCAN SECTION START ----
+
+enum scan_states {
+  SCAN_FDT_MODE,
+  SCAN_FDT_MODE_REPLY,
+  SCAN_SLEEP,
+  SCAN_QUERY_MCU,
+  SCAN_FDT_DOWN,
+  SCAN_WAIT_FINGER_DOWN,
+  SCAN_REG_ON,
+  SCAN_IMAGE,
+  SCAN_REG_OFF,
+  SCAN_SUBMIT,
+  SCAN_LIFT_REG_ON,
+  SCAN_LIFT_IMAGE,
+  SCAN_LIFT_REG_OFF,
+  SCAN_NUM_STATES,
+};
+
+static void
+on_finger_down (FpDevice *dev, guint8 *data, guint16 length, gpointer ssm,
+                GError *error)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (dev);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  self->pressed = FALSE;
+  self->press_polls = 0;
+  self->last_coverage = 0;
+  self->stable_polls = 0;
+  self->best_coverage = -1;
+  fpi_image_device_report_finger_status (FP_IMAGE_DEVICE (dev), TRUE);
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+on_press_image (FpDevice *dev, guint8 *data, guint16 length, gpointer ssm,
+                GError *error)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (dev);
+  gdouble coverage;
+
+  if (!error)
+    decode_frame (data, length, self->frame, &error);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  coverage = touched_share (self->frame, self->background);
+  fp_dbg ("Finger covers %.0f%% of the sensor", coverage * 100);
+  dump_raw (self->frame, self->background, "press");
+
+  if (coverage > self->best_coverage)
+    {
+      self->best_coverage = coverage;
+      memcpy (self->best_frame, self->frame, sizeof (self->best_frame));
+    }
+
+  self->press_polls++;
+  if (coverage >= GOODIX53XD_PRESS_MIN_COVERAGE &&
+      ABS (coverage - self->last_coverage) < GOODIX53XD_PRESS_STABLE_DELTA)
+    self->stable_polls++;
+  else
+    self->stable_polls = 0;
+  self->pressed = self->stable_polls >= GOODIX53XD_PRESS_STABLE_POLLS ||
+                  self->press_polls >= GOODIX53XD_PRESS_MAX_POLLS;
+  self->last_coverage = coverage;
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+on_press_reg_off (FpDevice *dev, gpointer ssm, GError *error)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (dev);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  if (self->pressed)
+    fpi_ssm_next_state (ssm);
+  else
+    {
+      self->scan_delayed = TRUE;
+      fpi_ssm_jump_to_state_delayed (ssm, SCAN_REG_ON,
+                                     GOODIX53XD_PRESS_POLL_MS);
+    }
+}
+
+static void
+on_lift_image (FpDevice *dev, guint8 *data, guint16 length, gpointer ssm,
+               GError *error)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (dev);
+
+  if (!error)
+    decode_frame (data, length, self->frame, &error);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  dump_raw (self->frame, self->background, "lift");
+  // Judge by absolute level, so a bad background cannot keep us waiting
+  self->lifted = update_background (self);
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+on_lift_reg_off (FpDevice *dev, gpointer ssm, GError *error)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (dev);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+
+  // There is no known finger-up FDT payload for 53xd, so poll frames
+  if (self->lifted)
+    fpi_ssm_next_state (ssm);
+  else
+    {
+      self->scan_delayed = TRUE;
+      fpi_ssm_jump_to_state_delayed (ssm, SCAN_LIFT_REG_ON,
+                                     GOODIX53XD_LIFT_POLL_MS);
+    }
+}
+
+static void
+scan_run_state (FpiSsm *ssm, FpDevice *dev)
+{
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case SCAN_FDT_MODE:
+      send_fdt (dev, GOODIX_CMD_MCU_SWITCH_TO_FDT_MODE, goodix_53xd_fdt_mode,
+                FALSE, GOODIX_TIMEOUT, ssm);
+      break;
+
+    case SCAN_FDT_MODE_REPLY:
+      send_fdt (dev, GOODIX_CMD_MCU_SWITCH_TO_FDT_MODE, goodix_53xd_fdt_mode,
+                TRUE, GOODIX_TIMEOUT, ssm);
+      break;
+
+    case SCAN_SLEEP:
+      {
+        const guint8 payload[] = { 0x01, 0x00 };
+
+        goodix_send_protocol (dev, GOODIX53XD_CMD_MCU_SWITCH_TO_SLEEP_MODE,
+                              payload, sizeof (payload), NULL, TRUE,
+                              GOODIX_TIMEOUT, FALSE,
+                              goodixtls5xx_check_none_cmd, ssm);
+        break;
+      }
+
+    case SCAN_QUERY_MCU:
+      {
+        const guint8 payload[] = { 0x01, 0x01, 0x01 };
+
+        goodix_send_protocol (dev, GOODIX_CMD_QUERY_MCU_STATE, payload,
+                              sizeof (payload), NULL, TRUE, GOODIX_TIMEOUT,
+                              FALSE, goodixtls5xx_check_none_cmd, ssm);
+        break;
+      }
+
+    case SCAN_FDT_DOWN:
+      send_fdt (dev, GOODIX_CMD_MCU_SWITCH_TO_FDT_DOWN, goodix_53xd_fdt_down,
+                FALSE, GOODIX_TIMEOUT, ssm);
+      break;
+
+    case SCAN_WAIT_FINGER_DOWN:
+      {
+        guint8 payload[GOODIX_53XD_FDT_LEN + 1];
+
+        // The reply only comes once a finger is on the sensor: no timeout
+        memcpy (payload, goodix_53xd_fdt_down, GOODIX_53XD_FDT_LEN);
+        payload[GOODIX_53XD_FDT_LEN] = 0x01;
+        goodix_send_protocol (dev, GOODIX_CMD_MCU_SWITCH_TO_FDT_DOWN, payload,
+                              sizeof (payload), NULL, TRUE, 0, TRUE,
+                              on_finger_down, ssm);
+        break;
+      }
+
+    case SCAN_REG_ON:
+    case SCAN_LIFT_REG_ON:
+      FPI_DEVICE_GOODIXTLS53XD (dev)->scan_delayed = FALSE;
+      goodix_send_write_sensor_register (dev, GOODIX53XD_REG_IMAGE,
+                                         GOODIX53XD_REG_IMAGE_ON,
+                                         goodixtls5xx_check_none, ssm);
+      break;
+
+    case SCAN_IMAGE:
+      request_image (dev, on_press_image, ssm);
+      break;
+
+    case SCAN_REG_OFF:
+      goodix_send_write_sensor_register (dev, GOODIX53XD_REG_IMAGE,
+                                         GOODIX53XD_REG_IMAGE_OFF,
+                                         on_press_reg_off, ssm);
+      break;
+
+    case SCAN_SUBMIT:
+      {
+        FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (dev);
+        FpImage *img = build_image (self->best_frame, self->background);
+        const gchar *dump = g_getenv ("FP_GOODIX53XD_DUMP");
+
+        fp_dbg ("Submitting frame with %.0f%% coverage after %d polls",
+                self->best_coverage * 100, self->press_polls);
+        // Debug aid: save every frame handed to libfprint, before NBIS
+        if (dump)
+          {
+            static guint dump_count = 0;
+            g_autofree gchar *path = g_strdup_printf ("%s/goodix53xd-%03u.pgm",
+                                                      dump, dump_count++);
+            goodixtls5xx_save_image_to_pgm (img, path);
+          }
+
+        fpi_image_device_image_captured (FP_IMAGE_DEVICE (dev), img);
+        fpi_ssm_next_state (ssm);
+        break;
+      }
+
+    case SCAN_LIFT_IMAGE:
+      request_image (dev, on_lift_image, ssm);
+      break;
+
+    case SCAN_LIFT_REG_OFF:
+      goodix_send_write_sensor_register (dev, GOODIX53XD_REG_IMAGE,
+                                         GOODIX53XD_REG_IMAGE_OFF,
+                                         on_lift_reg_off, ssm);
+      break;
+    }
+}
+
+static void
+scan_complete (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (dev);
+
+  self->scan_ssm = NULL;
+
+  if (error)
+    {
+      fp_err ("failed to scan: %s (code: %d)", error->message, error->code);
+      fpi_image_device_session_error (FP_IMAGE_DEVICE (dev), error);
+      return;
+    }
+
+  fpi_image_device_report_finger_status (FP_IMAGE_DEVICE (dev), FALSE);
+}
+
+// ---- SCAN SECTION END ----
+
+// -----------------------------------------------------------------------------
+
+// ---- DEV SECTION START ----
+
+static void
+dev_activate (FpImageDevice *img_dev)
+{
+  FpDevice *dev = FP_DEVICE (img_dev);
+
+  fpi_ssm_start (fpi_ssm_new (dev, activate_run_state, ACTIVATE_NUM_STATES),
+                 activate_complete);
+}
+
+static void
+dev_change_state (FpImageDevice *img_dev, FpiImageDeviceState state)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (img_dev);
+
+  if (state != FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_ON)
+    return;
+
+  if (self->scan_ssm)
+    {
+      fp_warn ("Scan already running");
+      return;
+    }
+
+  self->scan_ssm = fpi_ssm_new (FP_DEVICE (img_dev), scan_run_state,
+                                SCAN_NUM_STATES);
+  fpi_ssm_start (self->scan_ssm, scan_complete);
+}
+
+static void
+dev_deactivate (FpImageDevice *img_dev)
+{
+  FpiDeviceGoodixTls53xd *self = FPI_DEVICE_GOODIXTLS53XD (img_dev);
+  FpDevice *dev = FP_DEVICE (img_dev);
+  GError *error = NULL;
+
+  // A scan may be waiting for a finger; drop it with its pending command.
+  if (self->scan_ssm && self->scan_delayed)
+    fpi_ssm_cancel_delayed_state_change (self->scan_ssm);
+  self->scan_delayed = FALSE;
+  g_clear_pointer (&self->scan_ssm, fpi_ssm_free);
+  goodix_reset_state (dev);
+  goodix_shutdown_tls (dev, &error);
+
+  fpi_image_device_deactivate_complete (img_dev, error);
+}
+
+// ---- DEV SECTION END ----
+
+static void
+fpi_device_goodixtls53xd_init (FpiDeviceGoodixTls53xd *self)
+{
+  for (int i = 0; i != GOODIX53XD_FRAME_SIZE; ++i)
+    self->background[i] = GOODIX53XD_EMPTY_LEVEL;
+}
+
+static void
+fpi_device_goodixtls53xd_class_init (FpiDeviceGoodixTls53xdClass *class)
+{
+  FpiDeviceGoodixTlsClass *gx_class = FPI_DEVICE_GOODIXTLS_CLASS (class);
+  FpDeviceClass *dev_class = FP_DEVICE_CLASS (class);
+  FpImageDeviceClass *img_dev_class = FP_IMAGE_DEVICE_CLASS (class);
+  FpiDeviceGoodixTls5xxClass *xx_cls = FPI_DEVICE_GOODIXTLS5XX_CLASS (class);
+
+  xx_cls->firmware_version = GOODIX_53XD_FIRMWARE_VERSION;
+
+  gx_class->interface = GOODIX_53XD_INTERFACE;
+  gx_class->ep_in = GOODIX_53XD_EP_IN;
+  gx_class->ep_out = GOODIX_53XD_EP_OUT;
+  gx_class->skip_tls_established = TRUE;
+
+  dev_class->id = "goodixtls53xd";
+  dev_class->full_name = "Goodix TLS Fingerprint Sensor 53xd";
+  dev_class->type = FP_DEVICE_TYPE_USB;
+  dev_class->id_table = id_table;
+  dev_class->nr_enroll_stages = 15;
+
+  dev_class->scan_type = FP_SCAN_TYPE_PRESS;
+
+  // NBIS cannot work here: images carry at most ~8 minutiae, bozorth3 needs
+  // 10. SIGFM scores geometrically consistent SIFT matches instead.
+  // Measured with tools/sigfm-eval (15 min between enroll and probe): 24
+  // touches of 3 other fingers scored at most 3, and 4 of 8 genuine touches
+  // reached 10 or more. 10 keeps a 3x margin over the impostors seen.
+  img_dev_class->algorithm = FPI_DEVICE_ALGO_SIGFM;
+  img_dev_class->bz3_threshold = 10;
+  img_dev_class->img_width = GOODIX53XD_WIDTH * GOODIX53XD_SCALE;
+  img_dev_class->img_height = GOODIX53XD_HEIGHT * GOODIX53XD_SCALE;
+
+  img_dev_class->activate = dev_activate;
+  img_dev_class->deactivate = dev_deactivate;
+  img_dev_class->change_state = dev_change_state;
+
+  fpi_device_class_auto_initialize_features (dev_class);
+}
