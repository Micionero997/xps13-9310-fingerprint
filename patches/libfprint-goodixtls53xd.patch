+++ b/libfprint/sigfm/sigfm.cpp
@@ -0,0 +1,222 @@
+// SIGFM algorithm for libfprint
+
+// Copyright (C) 2022 Matthieu CHARETTE <matthieu.charette@gmail.com>
+// Copyright (c) 2022 Natasha England-Elbro <ashenglandelbro@protonmail.com>
